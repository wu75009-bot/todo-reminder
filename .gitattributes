# 统一换行符，避免 shell 脚本被 Windows 的 CRLF 破坏
* text=auto eol=lf

*.sh        text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.service   text eol=lf

# Windows 专用脚本保持 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.vbs       text eol=crlf
